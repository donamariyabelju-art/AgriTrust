# Flask Configuration
SECRET_KEY=agritrust-super-secure-key-change-in-production-2026
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Database Configuration (MySQL)
# Default MySQL connection settings:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agritrust_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Set to True to allow automatic SQLite fallback when local MySQL is unreachable
USE_SQLITE_FALLBACK=True

# Optional External APIs
# OpenWeatherMap API for live weather
WEATHER_API_KEY=
# LLM API Key (optional - system uses built-in Agronomy Assistant when not provided)
AI_API_KEY=

# Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
